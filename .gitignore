# 字节码 / 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/
ENV/

# 打包 / 安装
build/
dist/
*.egg-info/
.eggs/

# 用户本地配置（含密钥，禁止提交）
config.yaml
config.local.yaml
.env
*.secret

# 抖音插件登录态 Cookie（含个人账号信息，禁止提交；见 cookies.example.txt）
# cookies*.txt 覆盖 cookies.txt 及网盘同步产生的 cookies_冲突文件_*.txt
plugins/douyin_download/cookies*.txt
!plugins/douyin_download/cookies.example.txt

# B站插件扫码登录中间状态（含 qrcode_key，禁止提交）
plugins/bilibili_download/login_state.json

# 输出目录（运行产物）
output/
results/
downloads/
exports/

# 日志
*.log
logs/

# 测试 / 覆盖率
.pytest_cache/
.coverage
htmlcov/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.bak
.cache/

# 本地测试样例
tests_sample.*
